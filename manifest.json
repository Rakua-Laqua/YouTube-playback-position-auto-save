{
  "manifest_version": 3,
  "name": "YouTube 再生位置自動保存",
  "version": "1.3.0",
  "description": "YouTubeの再生位置を自動的に保存し、再訪問時に復元します",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
